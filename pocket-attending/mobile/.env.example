# Firebase console > Project settings > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1

# Google Cloud console > APIs & Services > Credentials (OAuth 2.0 client IDs)
# Web client ID (Firebase creates it when you enable Google sign-in) - used on Android and iOS
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# iOS client ID, and its reversed form as the URL scheme
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx

# App identity (must be unique in the stores)
APP_BUNDLE_ID=com.yourname.pocketattending
EAS_PROJECT_ID=

# Set to 1 to talk to the local Firebase emulators while developing
EXPO_PUBLIC_USE_EMULATORS=0
