PORT=3000
# Public URL of the site (used for the payment redirect). Required in production.
PUBLIC_URL=http://localhost:3000

# "mock" = sandbox (no real money). "flutterwave" = live/test Flutterwave checkout.
PAYMENT_PROVIDER=mock
# From Flutterwave dashboard > Settings > API keys (use FLWSECK_TEST-... for test mode)
FLW_SECRET_KEY=
# Any long random string; set the same value under Settings > Webhooks > Secret hash
FLW_SECRET_HASH=

# Minutes a room is held while the guest pays
HOLD_MINUTES=10
# Bearer token for POST /api/listings (adding properties)
ADMIN_TOKEN=
